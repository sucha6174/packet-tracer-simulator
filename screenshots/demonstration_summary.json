      },
      {
        "step": 3,
        "component": "DNS",
        "action": "Resolved portal.corp.net (via origin.corp.net) to 172.16.20.100"
      },
      {
        "step": 4,
        "component": "Router",
        "action": "Route matched: 172.16.20.0/24 via 172.16.20.1 on eth-dmz-app (prefix /24). Decremented TTL to 9"
      },
      {
        "step": 5,
        "component": "Firewall",
        "action": "Packet allowed by rule 4 (source: 10.0.0.0/8, port: 443, protocol: TCP)"
      },
      {
        "step": 6,
        "component": "Router",
        "action": "Packet forwarded to next hop 172.16.20.1 via interface eth-dmz-app"
      }
    ]
  },
